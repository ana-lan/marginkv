*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Environments and secrets
.venv/
venv/
.env
.env.*
*.token
hf_token*

# Caches and logs
.cache/
huggingface/
wandb/
logs/
*.log

# OS and editors
.DS_Store
.vscode/
.idea/
*.swpresults/vllm/runs/
